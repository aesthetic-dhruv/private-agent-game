# Godot import cache - regenerated by Godot, do not commit.
.godot/

# Build output - the CI workflow uploads this as an artifact instead.
build/

# Local debug keystore - generated fresh in CI, do not commit a real one.
# The workflow generates debug.keystore if it is missing, so a local
# copy is not needed in the repo.
debug.keystore

# Android / editor local files
*.apk
*.aab
export_presets.cfg.local
