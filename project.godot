; Engine configuration file.
; Godot 4.x - Voxel Heist (Teardown-inspired, original game, no Teardown assets/code)
config_version=5

[application]
config/name="Voxel Heist"
config/description="Original 3D sandbox heist game: destructible voxels, setup phase, 60-second alarm, escape vehicle. Inspired by Teardown's concept only."
config/version="0.1.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.2", "Mobile")

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/handheld/orientation="landscape"

[rendering]
renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true

